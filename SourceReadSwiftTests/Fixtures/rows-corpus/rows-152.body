<script>
var cookieName = "_xjpvictorsbook_blueFilter";
var op = Number(getCookie(cookieName));
function getCookie(name) {
  var value = "; " + document.cookie;
  var parts = value.split("; " + name + "=");
  if (parts.length == 2)
    return parts.pop().split(";").shift();
  else {
    document.cookie = name + '=-5;path=/;max-age=86400';
    return "-5";
  }
}
function toggleBlueFilter(invert) {
  if (op == 0)
    op = -5;
  if (invert) {
    if (op > 100) {
      op = -1 * (op - 100);
    } else if (op > 0) {
      op = op + 100;
    } else
      op = -op;
  }
  if (op > 100) {
    document.getElementById('blue-filter-tick').style.background = '#ff6347';
    document.getElementById('blue-filter-control').style.display = 'none';
    document.body.classList.add('dark');
  } else if (op > 0) {
    document.getElementById('blue-filter-tick').style.background = '#ff6347';
    document.getElementById('blue-filter-control').style.display = 'inline-block';
    document.body.classList.remove('dark');
  } else if (op < 0){
    document.getElementById('blue-filter-tick').style.background = '#bbb';
    document.getElementById('blue-filter-control').style.display = 'none';
    document.body.classList.remove('dark');
  }
  setBlueFilter();
}
function setBlueFilter() {
  if (op > 100) {
    o = Math.max(1, Math.min(9, op - 100));
    op = o + 100;
    o = 0;
  } else if (op < 0) {
    o = -1 * Math.min(-1, Math.max(-9, op));
    op = -1 * o;
    o = 0;
  } else {
    o = Math.max(1, Math.min(9, op));
    op = o;
  }
  document.getElementById('d').style.opacity = '.' + o;
  document.cookie = cookieName + '=' + op + ';path=/;max-age=86400';
  setBlueIndicator(document.getElementById('blue-filter-indicator'));
}
function setBlueIndicator(elem) {
  elem.innerHTML = '';
  for (i = 1; i <= 9; i++) {
    if (i <= op) {
      elem.innerHTML += '<span class="blue-filter-indicator-dot blue-filter-indicator-dot-on" onclick="op=' + i + ';setBlueFilter();">&nbsp;</span>';
    } else {
      elem.innerHTML += '<span class="blue-filter-indicator-dot" onclick="op=' + i + ';setBlueFilter();">&nbsp;</span>';
    }
  }
}
toggleBlueFilter(0);
document.getElementById('blue-filter-toggle').addEventListener('mousedown', function(e) {e.preventDefault();toggleBlueFilter(1);}, false);
document.getElementById('blue-filter-control-plus').addEventListener('mousedown', function(e) {
  e.preventDefault();
  op = op + 1;
  setBlueFilter();
}, false);
document.getElementById('blue-filter-control-minus').addEventListener('mousedown', function(e) {
  e.preventDefault();
  op = op - 1;
  setBlueFilter();
}, false);
</script>

