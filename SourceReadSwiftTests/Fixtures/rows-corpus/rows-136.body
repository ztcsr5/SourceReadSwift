&searchFrom=70000141","statParams":{"origin":70000141},"cat2tag":false},{"tagId":70000145,"tagName":"励志","qurl":"unitexxreader:/ativepage/tag?key=励志&actionTag=70000145,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000145","statParams":{"origin":70000145},"cat2tag":false}],"cbid":"11376293003560303","form":0,"price":-1,"chapterPriceSum":32324,"intro":"前世，她因软弱可欺不得善终。\n重回归来，她步步为营摆脱极品家人，顺道再报个恩。\n“喂，你别误会，我只是报你上辈子的救命之恩。”\n“救命之恩，当以身相报。”","newChapterTitle":"新书公告","free":0,"fileFormat":1,"centerAuthorId":"3004320501143901"},{"catel3name":"诸天","totalWords":9792882,"author":"鸿蒙求道者","num":0,"finished":0,"title":"斗破诸天：吾乃萧玄","lastChapter":0,"unitprice":5,"catel2name":"诸天无限","bookTagInfo":[{"tagId":70000238,"tagName":"穿越","qurl":"unitexxreader:/ativepage/tag?key=穿越&actionTag=70000238,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000238","statParams":{"origin":70000238},"cat2tag":false},{"tagId":70000229,"tagName":"无敌流","qurl":"unitexxreader:/ativepage/tag?key=无敌流&actionTag=70000229,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000229","statParams":{"origin":70000229},"cat2tag":false},{"tagId":70000250,"tagName":"诸天流","qurl":"unitexxreader:/ativepage/tag?key=诸天流&actionTag=70000250,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000250","statParams":{"origin":70000250},"cat2tag":false},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false},{"tagId":70000288,"tagName":"快节奏","qurl":"unitexxreader:/ativepage/tag?key=快节奏&actionTag=70000288,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000288","statParams":{"origin":70000288},"cat2tag":false}],"cbid":"24328376601739804","form":0,"price":-1,"chapterPriceSum":47211,"intro":"是梦是幻？\n管他是否虚无幻梦……，既成萧玄，那么该如何选择？是否还会孤注一掷？萧族面临的，又将是什么？","newChapterTitle":"7、99、战至超脱","free":0,"fileFormat":1,"centerAuthorId":"17544331007025101"},{"catel3name":"衍生同人","totalWords":1045737,"author":"蛋炒青椒","num":0,"finished":1,"title":"斗破之易宝系统","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000239,"tagName":"系统流","qurl":"unitexxreader:/ativepage/tag?key=系统流&actionTag=70000239,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000239","statParams":{"origin":70000239},"cat2tag":false},{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000202,"tagName":"反套路","qurl":"unitexxreader:/ativepage/tag?key=反套路&actionTag=70000202,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000202","statParams":{"origin":70000202},"cat2tag":false},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false}],"cbid":"20299249908497304","form":0,"price":-1,"chapterPriceSum":4034,"intro":"（新书【斗罗：武魂孤竹，猎杀穿越者】）\n蓝星青年萧瑟因为通宵阅读《斗罗之偷取万界系统》，不幸猝死，来到斗破世界。开启易宝系统。\r\n【滴，恭喜宿主用佐料罐交换到掌天瓶】\r\n【滴，恭喜宿主用止血散换取到了魔剑】\r\n【滴，恭喜宿主用娃娃换去到小猫咪】\r\n龙葵：哥哥，龙葵再也不要离开你。\r\n萧炎:我的为什么我的焚决变成艺术品了？异火又去哪了？……我的老婆呢？\r\n唐三：我的八蛛矛怎么变成鸡爪了？我的诸葛神弩怎么变成弹弓了？我的仙草......还有我的魂骨又怎么变成猪排骨了？\r\n韩老魔：我的掌天瓶怎么变成调料罐了？\r\n戴沐白:我的武魂白虎怎么变异成邪火猴子了？\r\n玉小刚:为啥身上多了个鸡蛋？\r\n.......\nps:主世界斗破苍穹——其他世界有斗罗大陆，剑道独尊，少年歌行，狐妖小红娘……","newChapterTitle":"新书来了","free":0,"fileFormat":1,"centerAuthorId":"4439301704338001"},{"catel3name":"衍生同人","totalWords":4069492,"author":"a小白b","num":0,"finished":1,"title":"从天才开始无敌于斗破","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000210,"tagName":"天才流","qurl":"unitexxreader:/ativepage/tag?key=天才流&actionTag=70000210,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000210","statParams":{"origin":70000210},"cat2tag":false},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false}],"cbid":"23743559709146404","form":0,"price":-1,"chapterPriceSum":18855,"intro":"有已完结同人：【斗破】、【全职法师】。【斗罗】连载中\n假如萧炎最初没有失去斗气。\n假如药老在魂戒中因重伤最终身死道消。\n假如萧炎因缘际会加入了魂殿。\n假如蝴蝶煽动了翅膀，命运脱离了原有轨道，齿轮会如何转动？\n“来者何人？”\n“魂殿，萧炎！”","newChapterTitle":"第1067章有限和无限","free":0,"fileFormat":1,"centerAuthorId":"7825478003858801"},{"catel3name":"东方玄幻","totalWords":3277169,"author":"梓云溪","num":0,"finished":1,"title":"皇后逆天斗苍穹","lastChapter":0,"unitprice":5,"catel2name":"玄幻言情","bookTagInfo":[{"tagId":70000083,"tagName":"穿越","qurl":"unitexxreader:/ativepage/tag?key=穿越&actionTag=70000083,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000083","statParams":{"origin":70000083},"cat2tag":false},{"tagId":70000047,"tagName":"女强","qurl":"unitexxreader:/ativepage/tag?key=女强&actionTag=70000047,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000047","statParams":{"origin":70000047},"cat2tag":false},{"tagId":70000150,"tagName":"爽文","qurl":"unitexxreader:/ativepage/tag?key=爽文&actionTag=70000150,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000150","statParams":{"origin":70000150},"cat2tag":false},{"tagId":70000138,"tagName":"贵女","qurl":"unitexxreader:/ativepage/tag?key=贵女&actionTag=70000138,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000138","statParams":{"origin":70000138},"cat2tag":false},{"tagId":70000025,"tagName":"东方玄幻","qurl":"unitexxreader:/ativepage/tag?key=东方玄幻&actionTag=70000025,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000025","statParams":{"origin":70000025},"cat2tag":true}],"cbid":"25432758000233501","form":0,"price":-1,"chapterPriceSum":15864,"intro":"帝国第一废物？丑女？因逼太子履行当年的婚约，而被全天下女性攻击致死？倒！既是天意弄人，让身为现代古武派的她重生在这废材身上，那么，她必逆天改命！离经叛道、乖张跋扈、强盗行径……闪瞎众人眼！她偏要狂，什么王爷、太子、皇帝、武林盟主，通通都归到她旗下吧！情节虚构，切勿模仿","newChapterTitle":"番外-时空大阵（完）","free":2,"fileFormat":1,"centerAuthorId":"5284899503075001"},{"catel3name":"同人衍生","totalWords":203112,"author":"如梅如菊傲雪凌霜","num":0,"finished":1,"title":"斗破：重生凤清儿之征服萧炎","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000036,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000036,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000036","statParams":{"origin":70000036},"cat2tag":true}],"cbid":"32461350803505107","form":0,"price":-1,"chapterPriceSum":733,"intro":"凤清儿重生回三十三年前，前世屡次败于萧炎之手，这一世定要拿捏萧炎。\r\n深思之后开启了萧炎培养计划，决定从开始就打好以她为主的习惯，让萧炎往东便不会往西。\r\n...\r\n凤清儿：“萧炎，别让我失望，你会帮我拿到龙凰本源果的，对么？”\r\n古熏儿：“萧炎哥哥只能是我一个人的！”\r\n美杜莎：“同为魔兽，我自然要与凤清儿同一阵线。”\r\n小医仙：“萧炎，你这个花心大萝卜！”\r\n紫妍：“杂毛鸟走开！”\r\n直到某一天天妖凰族被域外邪族入侵，数位堪比高阶斗圣的邪魔一举覆灭天妖凰族。\r\n萧炎：“魂天帝老贼，跟我去灭了异魔皇！”\r\n（异魔族是隔壁武祖boss，实力比肩斗帝）\r\n……","newChapterTitle":"新书《斗破：堕落！小医仙的复仇！》","free":0,"fileFormat":1,"centerAuthorId":"32189788811173704"},{"catel3name":"衍生同人","totalWords":3845363,"author":"风行云亦行","num":0,"finished":1,"title":"斗破之元素封神","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000238,"tagName":"穿越","qurl":"unitexxreader:/ativepage/tag?key=穿越&actionTag=70000238,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000238","statParams":{"origin":70000238},"cat2tag":false},{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false},{"tagId":70000279,"tagName":"狠辣","qurl":"unitexxreader:/ativepage/tag?key=狠辣&actionTag=70000279,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000279","statParams":{"origin":70000279},"cat2tag":false},{"tagId":70000292,"tagName":"热血","qurl":"unitexxreader:/ativepage/tag?key=热血&actionTag=70000292,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000292","statParams":{"origin":70000292},"cat2tag":false}],"cbid":"19085363308803104","form":0,"price":-1,"chapterPriceSum":18144,"intro":"新书《斗罗2：诸神之主》已经发布，老作者，不太监，有保障。\n这是斗气的世界，这是强者的天堂。\n陆云霄自虚无中走出，左手灵金璀璨，右手异火熊熊，身下圣水长河滚滚，身后无尽神雷轰鸣。\n大陆浩茫无垠，强者辈出，在这风起云涌的世界里，他注定一主沉浮！\nQQ群：1140958551","newChapterTitle":"完结感言：","free":0,"fileFormat":1,"centerAuthorId":"15713388905818601"},{"catel3name":"东方玄幻","totalWords":1165340,"author":"涂山满月","num":0,"finished":0,"title":"破怨师","lastChapter":0,"unitprice":5,"catel2name":"玄幻言情","bookTagInfo":[{"tagId":70000151,"tagName":"甜宠","qurl":"unitexxreader:/ativepage/tag?key=甜宠&actionTag=70000151,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000151","statParams":{"origin":70000151},"cat2tag":false},{"tagId":70000025,"tagName":"东方玄幻","qurl":"unitexxreader:/ativepage/tag?key=东方玄幻&actionTag=70000025,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000025","statParams":{"origin":70000025},"cat2tag":true}],"cbid":"27947017607321904","form":0,"price":-1,"chapterPriceSum":5187,"intro":"人有六欲（眼耳鼻舌身意），亦有七情（喜怒忧思悲恐惊）\n欲望源自脑，而七情则生发于心，念头易逝，情感永志。\n-\n若身死魂灭却情执仍在，“死体”就会变成“乱魄”贻害众生。\n“乱魄”是一种只存在于寐界的，由人魄滋生出来的诡怪，消除乱魄滋事，便是破怨师职责所在。\n-\n《破怨师》共涉七案，对应人之七情：\n念娘案——七情之忧\n鬼夫案——七情之思\n咒血案——七情之惊\n织梦案——七情之悲\n白袍案——七情之恐\n皮影案——七情之怒\n傀胎案——七情之喜\n-\n七案合为一场精心筹划的阴谋，“心梗级吐槽专家”宋微尘与“寐界司尘之主”墨汀风深陷其中，前世今生抽丝剥茧，成不了破案者，就成为受害人。","newChapterTitle":"第400章是敌是友？","free":0,"fileFormat":1,"centerAuthorId":"27870760509085501"},{"catel3name":"东方玄幻","totalWords":3934097,"author":"天蚕土豆","num":0,"finished":1,"title":"武动乾坤","lastChapter":0,"unitprice":5,"catel2name":"玄幻","bookTagInfo":[{"tagId":70000188,"tagName":"东方玄幻","qurl":"unitexxreader:/ativepage/tag?key=东方玄幻&actionTag=70000188,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000188","statParams":{"origin":70000188},"cat2tag":true},{"tagId":70000253,"tagName":"逆袭","qurl":"unitexxreader:/ativepage/tag?key=逆袭&actionTag=70000253,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000253","statParams":{"origin":70000253},"cat2tag":false},{"tagId":70000259,"tagName":"高武","qurl":"unitexxreader:/ativepage/tag?key=高武&actionTag=70000259,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000259","statParams":{"origin":70000259},"cat2tag":false},{"tagId":70000215,"tagName":"废柴流","qurl":"unitexxreader:/ativepage/tag?key=废柴流&actionTag=70000215,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000215","statParams":{"origin":70000215},"cat2tag":false},{"tagId":70000245,"tagName":"群像","qurl":"unitexxreader:/ativepage/tag?key=群像&actionTag=70000245,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000245","statParams":{"origin":70000245},"cat2tag":false},{"tagId":70000292,"tagName":"热血","qurl":"unitexxreader:/ativepage/tag?key=热血&actionTag=70000292,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000292","statParams":{"origin":70000292},"cat2tag":false}],"cbid":"22414434000750102","form":0,"price":-1,"chapterPriceSum":9471,"intro":"　　修炼一途，乃窃阴阳，夺造化，转涅盘，握生死，掌轮回。\r\n　　武之极，破苍穹，动乾坤！","newChapterTitle":"新书大主宰已发。","free":2,"fileFormat":1,"centerAuthorId":"3626814703153501"},{"catel3name":"衍生同人","totalWords":1541071,"author":"肥牛炖排骨","num":0,"finished":0,"title":"斗罗之葫芦","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false},{"tagId":70000295,"tagName":"轻松","qurl":"unitexxreader:/ativepage/tag?key=轻松&actionTag=70000295,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000295","statParams":{"origin":70000295},"cat2tag":false}],"cbid":"16516504004244304","form":0,"price":-1,"chapterPriceSum":5679,"intro":"新人作者，因为看斗罗同人更新太慢所以自己动手写了…\n我叫王小风，我现在很慌，因为睡个觉就穿越到了斗罗大陆（这也太随便了喂），还是在一个陌生的村子里，时间太久以至于忘记剧情的我，该怎么生活下去（狗头）\n简介2.0版\n书友群：1003584385（喜欢吐槽的随便进，杠精还是去贴吧吧，哪里老哥说话更好听，人也更有趣）","newChapterTitle":"第六百七十四章床头打架（）","free":0,"fileFormat":1,"centerAuthorId":"16516473205498601"},{"catel3name":"同人衍生","totalWords":1541023,"author":"瑟蕾莎","num":0,"cornerMark":"免费","finished":0,"title":"纳兰嫣然的无敌之路","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000036,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000036,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000036","statParams":{"origin":70000036},"cat2tag":true}],"cbid":"31802450007998807","form":0,"price":-1,"chapterPriceSum":0,"intro":"（单身＋成长流伪无敌+纯爽文）来自小说龙符里的一位被古尘沙秒杀的无敌力量的主角，穿越到了斗破苍穹的世界里，莫名寄宿在了云岚宗纳兰嫣然的识海中，并在苏醒后成为了纳兰嫣然的小透明师父，帮助纳兰嫣然成为新的无敌者。（斗破苍穹→？？？→）群1041330285","newChapterTitle":"第六百九十一章谢礼","free":1,"fileFormat":1,"centerAuthorId":"31408336911510904"},{"catel3name":"衍生同人","totalWords":6501804,"author":"柠檬邱霞","num":0,"finished":1,"title":"斗破苍穹神之炎帝","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false},{"tagId":70000245,"tagName":"群像","qurl":"unitexxreader:/ativepage/tag?key=群像&actionTag=70000245,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000245","statParams":{"origin":70000245},"cat2tag":false},{"tagId":70000292,"tagName":"热血","qurl":"unitexxreader:/ativepage/tag?key=热血&actionTag=70000292,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000292","statParams":{"origin":70000292},"cat2tag":false},{"tagId":70000288,"tagName":"快节奏","qurl":"unitexxreader:/ativepage/tag?key=快节奏&actionTag=70000288,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000288","statParams":{"origin":70000288},"cat2tag":false}],"cbid":"8896975503574403","form":0,"price":-1,"chapterPriceSum":29996,"intro":"新书（我的女友养成日常）已发\n\n五帝破空，结束亦是开始，新的起点。\n纵横大千世界，天骄无双，明争暗斗数不胜数。\n更是惹得无数英雄豪杰争相争夺，追寻那无上之道。\n大千之外，域外邪族虎视耽搁，新的风暴越演越烈。\n斗破后续，还是原班人马，倾力打造，热血大千！\nQQ交流群530477141","newChapterTitle":"开新书了（全职法师之亡灵罹难者）","free":0,"fileFormat":1,"centerAuthorId":"8896954004132401"},{"catel3name":"衍生同人","totalWords":494375,"author":"午时一刻","num":0,"finished":1,"title":"穿越斗破苍穹","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000238,"tagName":"穿越","qurl":"unitexxreader:/ativepage/tag?key=穿越&actionTag=70000238,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000238","statParams":{"origin":70000238},"cat2tag":false},{"tagId":70000239,"tagName":"系统流","qurl":"unitexxreader:/ativepage/tag?key=系统流&actionTag=70000239,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000239","statParams":{"origin":70000239},"cat2tag":false},{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000230,"tagName":"无限流","qurl":"unitexxreader:/ativepage/tag?key=无限流&actionTag=70000230,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000230","statParams":{"origin":70000230},"cat2tag":false},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false}],"cbid":"6545606703988003","form":0,"price":-1,"chapterPriceSum":1224,"intro":"（新书《斗破之万古\n至尊》已发布。）一觉醒来的萧畅发现自己穿越，而且还是穿越到斗破苍穹的世界了，还开启了，一个非常牛逼的系统。一样的世界，一样的人物，不一样的剧情，不一样的感觉。【苍穹诸神俱灭，斗气风云再起】","newChapterTitle":"三女相遇","free":0,"fileFormat":1,"centerAuthorId":"6108022404302101"},{"catel3name":"衍生同人","totalWords":1332653,"author":"梦回夕照","num":0,"finished":1,"title":"斗破苍穹之万界商城","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000238,"tagName":"穿越","qurl":"unitexxreader:/ativepage/tag?key=穿越&actionTag=70000238,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000238","statParams":{"origin":70000238},"cat2tag":false},{"tagId":70000239,"tagName":"系统流","qurl":"unitexxreader:/ativepage/tag?key=系统流&actionTag=70000239,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000239","statParams":{"origin":70000239},"cat2tag":false},{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=70000191,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000191","statParams":{"origin":70000191},"cat2tag":false},{"tagId":70000295,"tagName":"轻松","qurl":"unitexxreader:/ativepage/tag?key=轻松&actionTag=70000295,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000295","statParams":{"origin":70000295},"cat2tag":false},{"tagId":70000288,"tagName":"快节奏","qurl":"unitexxreader:/ativepage/tag?key=快节奏&actionTag=70000288,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000288","statParams":{"origin":70000288},"cat2tag":false}],"cbid":"6988313003606603","form":0,"price":-1,"chapterPriceSum":5283,"intro":"意外来到斗破苍穹世界的夜時秋拥有一个包涵万物的商城系统，界门开启，一个个位面之骄降临大陆，演绎出震撼人心的画面，远古四国凭空出世，斗气大陆唯我独尊！什么远古八族，太虚古龙，了不起么？小爷来自大天朝的华夏古国，看到我身后的一排小弟没有？还不过来跪舔！\nps:书友群：658542191","newChapterTitle":"新书《诸天万界BOSS聊天群》已发布。","free":2,"fileFormat":1,"centerAuthorId":"3789763904863801"},{"catel3name":"衍生同人","totalWords":754998,"author":"敖晨","num":0,"finished":1,"title":"从斗破苍穹签到开始","lastChapter":0,"unitprice":5,"catel2name":"轻小说","bookTagInfo":[{"tagId":70000238,"tagName":"穿越","qurl":"unitexxreader:/ativepage/tag?key=穿越&actionTag=70000238,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000238","statParams":{"origin":70000238},"cat2tag":false},{"tagId":70000239,"tagName":"系统流","qurl":"unitexxreader:/ativepage/tag?key=系统流&actionTag=70000239,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000239","statParams":{"origin":70000239},"cat2tag":false},{"tagId":70000229,"tagName":"无敌流","qurl":"unitexxreader:/ativepage/tag?key=无敌流&actionTag=70000229,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000229","statParams":{"origin":70000229},"cat2tag":false},{"tagId":70000196,"tagName":"其他衍生","qurl":"unitexxreader:/ativepage/tag?key=其他衍生&actionTag=70000196,-1,-1,-1,-1,6&pagestamp=1&searchFrom=70000196","statParams":{"origin":70000196},"cat2tag":true},{"tagId":70000191,"tagName":"二次元","qurl":"unitexxreader:/ativepage/tag?key=二次元&actionTag=7