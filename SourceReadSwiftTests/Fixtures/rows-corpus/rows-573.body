        <a id="J_GoTop" href="javascript:;">回到顶部</a>
    </div>
    <div class="banner">
        <div class="logo"></div>
        <a href="https://app.shubl.com/setting/download" id="download_btn" class="btn btn-outline-primary">下载</a>
    </div>
</div>
</body>

