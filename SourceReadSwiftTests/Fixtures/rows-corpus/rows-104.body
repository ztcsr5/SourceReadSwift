		mwc-button {
			--mdc-theme-primary: #424242;
			--mdc-theme-on-primary: #424242;
			--mdc-button-outline-color: #424242;
			--mdc-shape-small: 0;
			--mdc-typography-button-font-size: 13px;
			--mdc-typography-button-font-weight: 500;
		}

		.communication-banner-container {
			display: flex;
			align-items: center;
			min-height: 64px;
			padding-top: 16px;
			padding-bottom: 16px;
		}

		@media  screen and (max-width: 520px) {
			.communication-banner-container {
				display: none;
			}
		}

		.communication-banner-container .banner-content {
			width: 100%;
			display: flex;
			justify-content: space-between;
		}

		@media  screen and (max-width: 520px) {
			.communication-banner-container .banner-content {
				flex-direction: column;
			}
		}

		@media  screen and (min-width: 521px) {
			.communication-banner-container .banner-content {
				max-width: 1240px;
			}
		}

		.communication-banner-container .banner-content .description-wrapper {
			display: flex;
			align-items: center;
		}

		.communication-banner-container.m2-info {
			background-color: #f5f5f5;
		}

		.communication-banner-container.m2-warning {
			background-color: #fffde1;
		}

		.communication-banner-container.m2-dark {
			border-bottom: 1px solid #424242;
			background: #212121;
			color: #fff;
		}

		.communication-banner-container.m2-dark .banner-content {
			justify-content: center;
		}

		.communication-banner-container.m2-dark a {
			color: #fff;
		}

		.communication-banner-container.m3-sitewide {
			padding-top: 24px;
			padding-bottom: 24px;
			background-color: #e7f0f6;
			font-family: "Google Sans", sans-serif !important;
			font-weight: 400;
		}

		.communication-banner-container.m3-sitewide .banner-content {
			max-width: none;
		}

		.communication-banner-container.m3-sitewide .banner-headline {
			margin-bottom: 4px;
			color: #00658e;
			font-size: 20px;
			line-height: 26px;
		}

		@media  screen and (max-width: 520px) {
			.communication-banner-container.m3-sitewide .banner-headline {
				margin-bottom: 8px;
				font-size: 18px;
				line-height: 24px;
			}
		}

		.communication-banner-container.m3-sitewide .banner-description {
			color: #00658e;
			font-size: 14px;
			line-height: 20px;
		}

		.communication-banner-container.m3-sitewide mwc-button {
			--mdc-shape-small: 20px;
			--mdc-typography-button-font-family: "Google Sans Text", sans-serif !important;
			--mdc-typography-button-font-size: 14px;
			--mdc-typography-button-font-weight: 500;
			--mdc-typography-button-line-height: 20px;
			--mdc-typography-button-letter-spacing: 0;
			--mdc-typography-button-text-transform: none;
			--mdc-icon-font: "Google Material Icons";
			opacity: 1;
			line-height: normal;
		}

		.communication-banner-container.m3-sitewide .button-style-link {
			margin-left: 24px;
			opacity: 1;
		}

		.communication-banner-container.m3-sitewide .button-style-link:focus {
			border-radius: 22px;
			outline: 0;
			box-shadow: 0 0 0 2px #1f1f1f;
		}

		.communication-banner-container.m3-sitewide .button-style-link:hover mwc-button {
			--mdc-button-disabled-fill-color: #b2d7ef !important;
		}

		.communication-banner-container.m3-sitewide .button-style-link:active mwc-button {
			--mdc-button-disabled-fill-color: #abcfe7 !important;
		}

		.banner-icon {
			display: block;
			width: 24px;
			min-width: 24px;
			height: 24px;
			margin-right: 24px;
			background-repeat: no-repeat;
			background-size: contain;
		}

		@media  screen and (max-width: 920px) {
			.banner-icon {
				display: none;
			}
		}

		.banner-icon.warning {
			background-image: url("/static/angular/warning_24px.e9bbc26508a654e785b8.svg");
		}

		.banner-icon.info {
			background-image: url("/static/angular/info_24px.6e4c1b2270cb97a36c10.svg");
		}

		.cta-button {
			display: flex;
			align-items: center;
			white-space: nowrap;
		}

		@media  screen and (max-width: 520px) {

			.cta-button.m2-info,
			.cta-button.m2-warning,
			.cta-button.m2-dark {
				align-self: flex-end;
				margin-top: 8px;
				margin-left: 8px;
			}

			.cta-button.m3-sitewide {
				align-self: flex-start;
				margin-top: 16px;
				margin-left: 0;
			}

			.cta-button.m3-sitewide .button-style-link {
				margin-left: 0;
			}
		}
