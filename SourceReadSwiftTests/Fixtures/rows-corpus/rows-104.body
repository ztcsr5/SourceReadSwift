	<style>
		[_ngcontent-jpt-c16]:root {
			--mdc-theme-primary: #212121;
			--mdc-theme-secondary: #000;
			--mdc-theme-background: #fff;
			--mdc-theme-surface: #fff;
			--mdc-theme-error: #d32f2f;
			--mdc-theme-on-primary: #fff;
			--mdc-theme-on-secondary: #fff;
