                                    <div class="w_txt">
                                        <span class="sTit">
                                            <a href="/book/221639.html" target="_blank">
                                                                                                    <strong>划破</strong>长空                                                                                            </a>
                                        </span>
                                        <p class="pInfor clearfix">
                                            <span><em>作者：</em>
                                                                                                            柒月白
                                                                                                </span>
                                            <span><em>状态：</em>已完结</span>
