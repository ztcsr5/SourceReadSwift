<!-- 举报弹窗 -->
<script>
    $(document).on('click', '.js-report-illegality', function () {
        $.w_showPop($('.reject-pop'));
        $("#report_cate li").remove();
        $.getJSON("/report/ajaxGetReportCategory", function (result) {
            if (result.status) {
                // console.log(result.data);
                $.each(result.data, function (index, item) {
                    $("#report_cate").append("<li cid=" + item.id + ">" + item.category_name + "</li>")
                })
            }
        });
    })

    $(document).on('click', '#report_cate li', function () {
        var cateId = $(this).attr('cid');
        $('#cate_id').val(cateId);
        if (cateId == 5) {
            $('.js-report-guide').css('display', '')
        } else {
            $('.js-report-guide').css('display', 'none')
        }
    });

    $(document).on('click', '.js-report-confirm', function () {
        // console.log($('#cate_id').val() == '')
        if ($('#cate_id').val() == '') {
            $('.typeError').show();
            return false;
        } else {
            $('.typeError').hide();
        }
        if ($('.chapter_url').val() == '') {
            $('.chapterError').show();
            return false;
        } else {
            $('.chapterError').hide();
        }
        if ($('.report_content').val() == '') {
            $('.reportError').show();
            return false;
        } else {
            $('.reportError').hide();
        }
        var cate_id = $('#cate_id').val();
        var chapter_url = $('.chapter_url').val();
        var report_content = $('.report_content').val();
        var contact = $('.contact').val();
        $.post('/report/ajaxInsertReport', {
            cate_id: cate_id,
            chapter_url: chapter_url,
            report_content: report_content,
            contact: contact
        }, function (result) {
            if (result.status == 1) {
                $.Toast({title: '提交成功'});
                // 隐藏弹窗及清空表单信息
                $.w_hidePop($('.reject-pop'));
                $('.chapter_url').val('');
                $('.report_content').val('');
                $('.contact').val('');
            } else {
                $.Toast({title: result.msg});
            }

        });
    })
</script>
