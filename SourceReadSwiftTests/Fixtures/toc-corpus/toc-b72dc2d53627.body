<script>
function keyboardShortcut(e) {
  var keynum = (window.event ? e.keyCode : (e.which ? e.which : false));
  if (keynum === false)
    return false;
  if (e.target.tagName.toUpperCase() == 'BODY') {
    if (keynum == '37') {
      // left
      e.preventDefault();
      e.stopPropagation();
      if (document.getElementById('prev'))
        window.location = document.getElementById('prev').getAttribute('href');
    } else if (keynum == '39') {
      // right
      e.preventDefault();
      e.stopPropagation();
      if (document.getElementById('next'))
        window.location = document.getElementById('next').getAttribute('href');
    }
  }
}
window.addEventListener('keyup', function(event){keyboardShortcut(event);});
</script>

