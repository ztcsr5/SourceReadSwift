<script>
function hideShare() {
  if (null == document.getElementById('shareb')) {
    return false;
  }
  shareb = document.getElementById('shareb');
  shareb.style.display = 'none';
  document.getElementById('c').style.opacity = '1.0';
  document.getElementById('c').removeEventListener("mousedown", hideShare);
}
function showShare(m) {
  if (!m && (!ssb || null == document.getElementById('shareb'))) {
    return false;
  }
  var name = '_xjpvictorsbook_showShare';
  var value = "; " + document.cookie;
  var parts = value.split("; " + name + "=");
  if (parts.length == 2) {
    return false;
  } else {
    shareb = document.getElementById('shareb');
    shareb.style.display = 'block';
    document.getElementById('c').style.opacity = '0.3';
    document.getElementById('c').addEventListener("mousedown", hideShare);
    document.cookie = name + '=0;path=/;max-age=7200';
  }
  ssb = 0;
}
var ssb = 1;
setTimeout("showShare(0)", 600000);
</script>


