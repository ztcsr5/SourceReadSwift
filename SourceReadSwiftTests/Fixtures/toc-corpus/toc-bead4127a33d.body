			page = 1;
			if (hash != "") {
				$.each($('.comment'), function(i,v) {
					if ($('.comment').eq(i).attr('id') == hash) {
						page = (Math.floor(i/15))+1;
						return false;
					}
				});
			}

			$(".comments-page-" + page).show();
			$('#page-selection-top, #page-selection-bottom').bootpag({
				total: 1,
				page: page,
				maxVisible: 5,
				leaps: false, 
