<!-- 用户账户拥有的打赏的金钱数 -->
<input type="hidden" id="dstramenum" value="0">
<input type="hidden" name="tformhash" value="bc3fcacd">
<input type="hidden" name="tkuid" value="156096"><!-- Google tag (gtag.js) -->
<script src="https://www.googletagmanager.com/gtag/js?id=G-SP9EJQG7G8" type="text/javascript"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-SP9EJQG7G8');
</script>
<!-- 侧栏 -->
<script>
'use strict';
function jumpnextpage(){
  return false;
}

function jumpprevpage(){
  return false;
}
var jamesonmanhua = {
  uid:parseInt('0'),
  chongzhi:$.trim(""),
  login:function (url) {
    if (!jamesonmanhua.uid) {
       url = url?url:location.href;
        $.confirm('请登录', function () {
                  location.href='member.php?mod=logging&action=login&referer=' + encodeURIComponent(url);
        });
        return false;
    }
  },
  kaiguan:function(em){
    var isguan = parseInt($(em).attr('data-status'));
    isguan = isguan==1?2:1;
    $("#jamesonmanhuatouch").toggleClass('theme-dark')
    $.cookie("u0F3_2132_manhuakaiguan",isguan,{expires:10})
  },
  morepinglun:function(em){
    var current = parseInt($("#currentpage").val());
    var pages = parseInt($("#totalpages").val());
    var kuid = parseInt($("#kuidinput").val());
    if(current >= pages){
      $(em).text('没有了').addClass('disabled')
      return false;
    }
    $.post('./plugin.php',{
      id:'jameson_manhua:ajax',
      optype:'morepinglun',
      formhash:'bc3fcacd',
      page:current,
      kuid:kuid,
      shebei:'mobile'
    },function(res){
      if(res == 'error'){
        $.toast('操作出错请重试')
      }else if(res=='meiyoule'){
        jQuery(em).text('没有了').addClass('disabled');
      }else{
        jQuery('#pinglun-content').append( res);
        current++;
        jQuery("#currentpage").val(current);
      }
    })
  },
      postpinglun: function() {
            if (!jamesonmanhua.uid) {
                $.confirm('请登录', function () {
                          location.href='member.php?mod=logging&action=login&referer=' + encodeURIComponent(location.href);
                });
                return false;
            }
            var text = $.trim($(".pinglun-text textarea").eq(0).val());
            if (!text) {
                $.toast('没有填写评论内容');
                return false;
            } else if (text.length > 400) {
                $.toast('评论内容不得大于400字');
                return false;
            }
            $.post('./plugin.php',{
              id:'jameson_manhua:ajax',
              optype:'postpinglun',
              formhash:'bc3fcacd',
              kuid:'156096',
              text:text
            },  function(res) {
                let k = JSON.parse(res);
                let res_ret = k['ret'];

                if (res_ret == 'has') {
                    $.toast('已发布过');
                } else if (res_ret != 'success') {
                    $.toast('发布出错请重试');
                } else {
                    $.toast('发布成功');
                    var div = `<div class="card facebook-card"><div class="card-header no-border"><div class="facebook-avatar"><img src="${k['user_avatar']}" width="34" height="34"></div><div class="facebook-name">${k['username']}</div><div class="facebook-date">${k['addtime']}</div></div><div class="card-content"><p class="">`+escapeHtml(k['text']) +'</p></div></div>';
                    $(".pinglun-text textarea").eq(0).val('');
                    $('#pinglun-content').prepend(div); 
                }
            });
            return false;
        },
        favores:function(kuid,em){
          if(!jamesonmanhua.uid){
            jamesonmanhua.login()
          }else{
                if($(em).attr('disabled')){
                return;
              }
              $.post('./plugin.php',{
                optype:'favores',
                formhash:'bc3fcacd',
                is_fav: 1,
                kuid:kuid,
                id:'jameson_manhua:ajax'
              },function(res){
                if(res=='error'){
                  $.toast('操作失败','#f00')
                }else{
                  let spanv = $('#mfavores');
                  let text = spanv.text();
                  let match = text.match(/收藏(\d+)/);
                  if (match) {
                    let count = parseInt(match[1], 10);
                    count += 1; 
                    spanv.text("收藏" + count);
                  }
                  $(em).attr('disabled','disabled').text('已收藏');
                  $.toast('收藏成功')
                }
              })
          }
          
        },

        clearfavores:function(el){
            if(!jamesonmanhua.uid){

              jamesonmanhua.login()

            }	
            if(!confirm('确认删除全部收藏？')){

              return false;
            }
            jQuery.post('./plugin.php',{

                optype:'clearfavores',

                formhash:'bc3fcacd',
                id:'jameson_manhua:ajax'

                },function(res){

                if(res=='error'){
                  $.toast('操作失败');
                }else{
                  location.reload()
                }
            })
            },

            dashang:function(){
                  if (!jamesonmanhua.uid) {
                      jamesonmanhua.login()
                      return;
                  }
                  if (!$("#dashangnum").length) {
                      return false;
                  }
                  var  tramenum = parseInt($("#dstramenum").val())?parseInt($("#dstramenum").val()):0;
                  var dashangnum = parseInt($("#dashangnum").val())?parseInt($("#dashangnum").val()):0;
                  if (dashangnum < 1) {
                      $.toast('必须填写大于0的打赏金额');
                      return;
                  }
                  if (dashangnum > tramenum) {
                    if(jamesonmanhua.chongzhi && confirm('金钱不足，请充值')){
                      location.href =jamesonmanhua.chongzhi;
                    }else if(!jamesonmanhua.chongzhi){
                        $.toast('金钱不足，请充值');
                    }
                      return false;
                  }
                  if(jamesonmanhua.uid=='1'){
                    $.toast('不要打赏自己哦');
                    return;
                  }
                  $.post('./plugin.php',{
                    id:'jameson_manhua:ajax',
                    formhash:'bc3fcacd',
                    optype:'dashang',
                    kuid:parseInt("156096"),
                    zjid:0,
                    dashangnum:dashangnum
                  }, function(res) {
                      if (res == 'buzu') {
                          $.toast('金钱!buzuqingchongzhi!');
                      } else if (res == 'error') {
                          $.toast('操作出错请重试');
                      } else if (res == 'success') {
                          $.toast('感谢你的打赏');
                          $("#dstramenum").val(tramenum - dashangnum);
                          $("#dashangnum").val('');
                          jamesonmanhua.hideds(1)
                      }
                  });
              },
        hideds:function(act){
          if(act){
            $("#dashangdiv").addClass('none');
            $("#zhezhao").addClass('none');
          }else{
            $("#dashangdiv").removeClass('none');
            $("#zhezhao").removeClass('none');
          }
        },

        order:function(field,order){
    	var url = location.href;
    	if(!order || (order.toLowerCase()=='desc')){
    		order = 'desc';
    	}else if(order.toLowerCase()=='asc'){
    		order = 'asc';
    	}
    	if(/odfie/i.test(url)){
    		url = url.replace(/odfie=\w+/i,'odfie='+field)
    	}else{
    		url += '&odfie='+field;
    	}
    	if(/order/i.test(url)){
    		url = url.replace(/order=\w+/i,'order='+order)
    	}else{
    		url += '&order='+order;
    	}
    	location.href = url;
    },
        openimg:function(index){
          if(jamesonmanhua.myphoto){
            jamesonmanhua.myphoto.open(index);
            setTimeout(function(){
              $(".photo-browser > .bar").addClass('none')
            },1000);
            $(".photo-browser-slide").on('click',function(){
              $(".photo-browser > .bar").toggleClass('none')
            })
          }
        },
        myphoto:false
};
$(function () {
    $.init();
    $(document).on('click','.back',function(){
      history.go(-1) 
    });
});


function escapeHtml(text) {
        return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
  }


</script>
</body>
</html>